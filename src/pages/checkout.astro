---
import '../styles/global.css';
import '../styles/finder.css';
import '../styles/checkout.css';
import { catalog } from '../data/catalog.js';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Review your Bima Books order and send it to us on WhatsApp. Storybooks and learning toys, delivered in Abuja.">
    <title>Your Order | Bima Books</title>
    <meta name="theme-color" content="#0e1840">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preload" href="/fonts/caprasimo-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/atkinson-latin-400.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="Bima Books home">
                <span class="brand-mark">Bima Books</span>
                <span class="brand-sub">STORYBOOKS & TOYS</span>
            </a>
            <nav class="site-nav">
                <a href="/">Shop all</a>
                <a href="/finder">Find their books</a>
            </nav>
        </div>
    </header>

    <main class="checkout">
        <div class="container">
            <div class="checkout-header">
                <span class="eyebrow">Your order</span>
                <h1>Let's get these books home.</h1>
                <p>Check your stack, add your delivery details, then send it straight to Bima Books on WhatsApp. We'll confirm availability, delivery and payment with you personally.</p>
                <a class="checkout-back" href="/">← Back to the shelf</a>
            </div>

            <div class="checkout-grid">
                <section class="checkout-card" aria-labelledby="order-title">
                    <h2 id="order-title">Your book stack</h2>
                    <div class="order-list" id="orderList"></div>
                    <div id="orderEmpty" class="empty-order" hidden>
                        Your order is empty. <a href="/">Browse the shelf</a> or <a href="/finder">take the book finder</a>.
                    </div>
                    <div class="order-summary-line">
                        <span>Total</span>
                        <span id="orderTotal">Confirmed on WhatsApp</span>
                    </div>
                    <a class="checkout-back" href="/">← Keep browsing</a>
                </section>

                <form class="checkout-card checkout-form" id="checkoutForm" novalidate>
                    <h2>Delivery details</h2>
                    <div class="form-grid">
                        <div class="field full">
                            <label for="name">Your name</label>
                            <input id="name" name="name" type="text" autocomplete="name" placeholder="e.g. Ada Obi" required>
                        </div>
                        <div class="field">
                            <label for="phone">Phone number</label>
                            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="e.g. 0801 234 5678" required>
                        </div>
                        <div class="field">
                            <label for="email">Email <span class="field-hint">(for card payment)</span></label>
                            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com">
                        </div>
                        <div class="field full">
                            <label for="address">Delivery address</label>
                            <textarea id="address" name="address" autocomplete="street-address" placeholder="House number, street, area" required></textarea>
                        </div>
                        <div class="field">
                            <label for="city">City</label>
                            <input id="city" name="city" type="text" autocomplete="address-level2" placeholder="e.g. Lagos" required>
                        </div>
                        <div class="field">
                            <label for="state">State</label>
                            <input id="state" name="state" type="text" autocomplete="address-level1" placeholder="e.g. Lagos" required>
                        </div>
                        <div class="field full">
                            <label for="note">Anything else? <span class="field-hint">(optional)</span></label>
                            <textarea id="note" name="note" placeholder="Gift note, delivery instructions, questions..."></textarea>
                        </div>
                    </div>

                    <h2>Payment</h2>
                    <div class="payment-options">
                        <label class="payment-option">
                            <input type="radio" name="payment" value="whatsapp" checked>
                            <span>
                                <strong>Order on WhatsApp</strong>
                                <span>We'll confirm the total, delivery fee and payment details with you.</span>
                            </span>
                        </label>
                        <label class="payment-option" id="paystackOptionLabel">
                            <input type="radio" name="payment" value="paystack" id="paystackOption">
                            <span>
                                <strong>Pay online with Paystack</strong>
                                <span id="paystackNote">Card payment is being set up. Please use WhatsApp for now.</span>
                            </span>
                        </label>
                    </div>

                    <div class="checkout-actions">
                        <button class="btn btn-whatsapp" type="submit" id="checkoutSubmit">Send order on WhatsApp</button>
                        <p class="checkout-note" id="checkoutNote">You'll be taken to WhatsApp to send your order. No payment is taken on this site unless you choose Paystack.</p>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="brand" href="/">
                <span class="brand-mark">Bima Books</span>
                <span class="brand-sub">STORYBOOKS & TOYS</span>
            </a>
            <p>Hand-picked books and toys for ages 0 to 12. Abuja delivery.</p>
            <a href="https://www.instagram.com/bima_books/" target="_blank" rel="noopener">@bima_books</a>
        </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script is:inline define:vars={{ books: catalog }}>
        window.BIMA_CATALOG = books;
    </script>
    <script is:inline src="/config.js"></script>
    <script is:inline src="/cart.js"></script>
    <script is:inline src="/checkout.js"></script>
</body>
</html>

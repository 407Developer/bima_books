---
import '../styles/catalog.css';
import { catalog, formatNaira, cardMeta } from '../data/catalog.js';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bima Books · Storybooks and learning toys for kids in Abuja</title>
    <meta name="description" content="Hand-picked Grade A storybooks and learning toys for ages 0 to 12, from ₦1,500. Order on WhatsApp, delivered in Abuja.">
    <meta property="og:title" content="Bima Books · Raise a reader, not a screen kid">
    <meta property="og:description" content="Storybooks and learning toys for ages 0 to 12, from ₦1,500. Order on WhatsApp, delivered in Abuja.">
    <meta name="theme-color" content="#0e1840">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preload" href="/fonts/caprasimo-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/atkinson-latin-400.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
    <a class="skip-link" href="#shelf">Skip to the shelf</a>

    <header class="top">
        <div class="wrap top-bar">
            <a class="mark" href="/">Bima Books</a>
            <button class="cart-btn" type="button" aria-haspopup="dialog" aria-label="Your order is empty">
                <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="moon-dark" cx="12" cy="12" r="10"></circle>
                    <path class="moon-lit" d="M12 2A10 10 0 0 1 12 22C17.5 22 22 17.5 22 12C22 6.5 17.5 2 12 2Z"></path>
                </svg>
                <span class="cart-label">Order</span>
                <span class="cart-count">0</span>
            </button>
        </div>
    </header>

    <main id="top">
        <section class="hero">
            <div class="wrap hero-grid">
                <div class="moon">
                    <svg class="rings" viewBox="0 0 200 200" aria-hidden="true">
                        <circle cx="100" cy="100" r="74"></circle>
                        <circle cx="100" cy="100" r="86" stroke-dasharray="0 7"></circle>
                        <circle cx="100" cy="100" r="98" stroke-dasharray="14 8"></circle>
                    </svg>
                    <img src="/img/moon.webp" alt="Illustration of a mother reading a Bima Books story to her toddler" width="720" height="720" fetchpriority="high">
                </div>
                <div class="hero-copy">
                    <h1>Raise a reader, not a screen kid.</h1>
                    <p class="offer">Grade A storybooks and learning toys for ages 0 to 12. <strong>From ₦1,500, delivered in Abuja.</strong> Order on WhatsApp.</p>
                    <div class="ask">
                        <p id="ask-label">How old is your child?</p>
                        <div class="chips" role="group" aria-labelledby="ask-label">
                            <button class="chip chip-big" type="button" data-age="0-2" aria-pressed="false">0–2 yrs</button>
                            <button class="chip chip-big" type="button" data-age="3-5" aria-pressed="false">3–5 yrs</button>
                            <button class="chip chip-big" type="button" data-age="6-8" aria-pressed="false">6–8 yrs</button>
                            <button class="chip chip-big" type="button" data-age="9-12" aria-pressed="false">9–12 yrs</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="shelf paper" id="shelf" aria-labelledby="shelf-title">
            <div class="wrap">
                <div class="shelf-head">
                    <h2 id="shelf-title">On the shelf now.</h2>
                    <p class="count" aria-live="polite">{catalog.length} picks</p>
                </div>
                <div class="filters">
                    <div class="chips" role="group" aria-label="Filter by age">
                        <button class="chip" type="button" data-age="0-12" aria-pressed="true">All ages</button>
                        <button class="chip" type="button" data-age="0-2" aria-pressed="false">0–2 yrs</button>
                        <button class="chip" type="button" data-age="3-5" aria-pressed="false">3–5 yrs</button>
                        <button class="chip" type="button" data-age="6-8" aria-pressed="false">6–8 yrs</button>
                        <button class="chip" type="button" data-age="9-12" aria-pressed="false">9–12 yrs</button>
                    </div>
                    <div class="chips" role="group" aria-label="Filter by type">
                        <button class="chip" type="button" data-kind="all" aria-pressed="true">Everything</button>
                        <button class="chip" type="button" data-kind="book" aria-pressed="false">Books</button>
                        <button class="chip" type="button" data-kind="bundle" aria-pressed="false">Bundles</button>
                        <button class="chip" type="button" data-kind="toy" aria-pressed="false">Learning toys</button>
                    </div>
                </div>
                <ul class="grid">
                    {catalog.map((item, index) => (
                        <li class="item" data-kind={item.kind} data-min={item.ages[0]} data-max={item.ages[1]}>
                            <img src={item.image} alt="" width="480" height="600" loading={index < 2 ? 'eager' : 'lazy'} decoding="async">
                            <p class="ticket">
                                <span class="ticket-price">{formatNaira(item.price)}</span>
                                <span class="ticket-meta">{cardMeta(item)}</span>
                            </p>
                            <h3>{item.title}</h3>
                            <button class="add" type="button" data-add={item.id}>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"></path>
                                </svg>
                                Add to order
                            </button>
                            <div class="stepper">
                                <button type="button" data-step="-1" data-id={item.id} aria-label={`Remove one ${item.title}`}>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M5 12h14"></path>
                                    </svg>
                                </button>
                                <output>0</output>
                                <button type="button" data-step="1" data-id={item.id} aria-label={`Add one more ${item.title}`}>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 5v14M5 12h14"></path>
                                    </svg>
                                </button>
                            </div>
                        </li>
                    ))}
                </ul>
                <div class="empty" hidden>
                    <p>Nothing on the shelf matches that yet.</p>
                    <a class="btn btn-line" href="#pick">Ask us to pick instead</a>
                </div>
            </div>
        </section>

        <section class="finder-strip" aria-label="Book finder">
            <div class="wrap">
                <p><strong>Not sure where to start?</strong> Answer five quick questions and we’ll shortlist three books that fit.</p>
                <a class="btn btn-line" href="/finder">Find their books</a>
            </div>
        </section>

        <section class="pick" id="pick" aria-labelledby="pick-title">
            <div class="wrap pick-grid">
                <div class="pick-copy">
                    <h2 id="pick-title">Not sure? Tell us their age.</h2>
                    <p>Boy or girl, early reader or confident reader. Send us your child's age and what they love, and we reply on WhatsApp with books that fit.</p>
                    <p class="finder-inline"><a href="/finder">Prefer a quick quiz? Find their stack →</a></p>
                </div>
                <form class="pick-form" novalidate>
                    <label>How old is your child?
                        <select name="age" required>
                            <option value="">Choose an age</option>
                            <option>Under 1</option>
                            <option>1 year</option>
                            <option>2 years</option>
                            <option>3 years</option>
                            <option>4 years</option>
                            <option>5 years</option>
                            <option>6 years</option>
                            <option>7 years</option>
                            <option>8 years</option>
                            <option>9 years</option>
                            <option>10 years</option>
                            <option>11 years</option>
                            <option>12 years</option>
                        </select>
                        <span class="error" hidden>Choose an age so we can pick the right books.</span>
                    </label>
                    <fieldset>
                        <legend>The books are for</legend>
                        <label class="radio"><input type="radio" name="for" value="a boy">A boy</label>
                        <label class="radio"><input type="radio" name="for" value="a girl">A girl</label>
                        <label class="radio"><input type="radio" name="for" value="any child" checked>Either</label>
                    </fieldset>
                    <label>What do they love? <span class="optional">Optional</span>
                        <input name="loves" placeholder="Dinosaurs, princesses, numbers" autocomplete="off">
                    </label>
                    <label>Budget in naira <span class="optional">Optional</span>
                        <input name="budget" inputmode="numeric" placeholder="10,000" autocomplete="off">
                    </label>
                    <button class="btn btn-night" type="submit">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7.9 20A9 9 0 1 0 4 16.1L2.5 21.5Z"></path>
                            <path d="M9.2 8.4c-.5.3-.9.8-.8 1.5.3 2.7 2.5 4.9 5.2 5.4.8.1 1.4-.3 1.7-.9l-1.8-1.1-.9.7a4.2 4.2 0 0 1-2.2-2.2l.7-.9z"></path>
                        </svg>
                        Ask us on WhatsApp
                    </button>
                </form>
            </div>
        </section>

        <section class="proof paper" aria-labelledby="proof-title">
            <div class="wrap proof-grid">
                <h2 id="proof-title">Parents say it better.</h2>
                <figure class="reel">
                    <div class="reel-media">
                        <img src="/img/natasha-poster.webp" alt="Natasha's daughter reading a Bima Books story" width="540" height="960" loading="lazy" decoding="async">
                        <a class="play" href="https://www.instagram.com/tashaikem/" target="_blank" rel="noopener" aria-label="Watch Natasha's video on Instagram">
                            <span>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none"></path>
                                </svg>
                            </span>
                        </a>
                    </div>
                    <figcaption>
                        <blockquote>
                            <p>They are enjoying their books and puzzles so much from @bima_books. I think Kosi is enjoying his own the most.</p>
                        </blockquote>
                        <cite>Natasha, <a href="https://www.instagram.com/tashaikem/">@tashaikem</a> on Instagram</cite>
                    </figcaption>
                </figure>
                <div class="quotes">
                    <blockquote>
                        <p>Many thanks once again for our Cinderella book. I believe it will further add to the reader's sweet diction.</p>
                        <cite>A parent, on WhatsApp</cite>
                    </blockquote>
                    <blockquote>
                        <p>No wahala Ma'am. 1st grade thrift.</p>
                        <cite>A parent, on WhatsApp</cite>
                    </blockquote>
                </div>
            </div>
        </section>

        <section class="steps paper" aria-labelledby="steps-title">
            <div class="wrap">
                <h2 id="steps-title">Ordering takes one message.</h2>
                <ol>
                    <li>
                        <h3>Pick</h3>
                        <p>Add books and toys to your order here, or ask us to pick for you.</p>
                    </li>
                    <li>
                        <h3>Send</h3>
                        <p>Your order opens in WhatsApp, already typed. Just press send.</p>
                    </li>
                    <li>
                        <h3>Pay</h3>
                        <p>We confirm stock and send an invoice. You pay by bank transfer.</p>
                    </li>
                    <li>
                        <h3>Read</h3>
                        <p>We deliver in Abuja. Outside Abuja? Ask us on WhatsApp.</p>
                    </li>
                </ol>
            </div>
        </section>

        <section class="close" aria-labelledby="close-title">
            <div class="wrap">
                <h2 id="close-title">Story time starts tonight.</h2>
                <blockquote class="tip">
                    <p>There is no wrong way to read to a toddler. Skip pages, repeat pages, make silly voices and let them lead. That is still reading.</p>
                </blockquote>
                <div class="close-actions">
                    <a class="btn btn-fire" href="https://wa.me/2349025742445?text=Hello%20Bima%20Books%2C%20I%20would%20like%20to%20order%20some%20books%20for%20my%20child." target="_blank" rel="noopener">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7.9 20A9 9 0 1 0 4 16.1L2.5 21.5Z"></path>
                            <path d="M9.2 8.4c-.5.3-.9.8-.8 1.5.3 2.7 2.5 4.9 5.2 5.4.8.1 1.4-.3 1.7-.9l-1.8-1.1-.9.7a4.2 4.2 0 0 1-2.2-2.2l.7-.9z"></path>
                        </svg>
                        Chat with us on WhatsApp
                    </a>
                    <a class="btn btn-line" href="https://www.instagram.com/bima_books/">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                            <circle cx="12" cy="12" r="4"></circle>
                            <circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"></circle>
                        </svg>
                        See new arrivals on Instagram
                    </a>
                </div>
            </div>
        </section>
    </main>

    <footer class="foot">
        <div class="wrap">
            <p>Bima Books, Abuja. Storybooks and learning toys for ages 0 to 12.</p>
            <p>
                <a href="https://wa.me/2349025742445?text=Hello%20Bima%20Books%2C%20I%20would%20like%20to%20order%20some%20books%20for%20my%20child." target="_blank" rel="noopener">WhatsApp +234 902 574 2445</a> · <a href="https://www.instagram.com/bima_books/">@bima_books</a>
            </p>
        </div>
    </footer>

    <dialog class="cart paper" aria-labelledby="cart-title" data-empty="true">
        <div class="cart-head">
            <h2 id="cart-title">Your order</h2>
            <button class="icon-btn" type="button" data-close aria-label="Close your order">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6 6 18"></path>
                </svg>
            </button>
        </div>
        <div class="cart-empty">
            <p>Your order is empty.</p>
            <p>Add a book from the shelf, or tell us your child's age and we will pick.</p>
            <a class="btn btn-fire" href="#shelf" data-close>Browse the shelf</a>
        </div>
        <div class="cart-full">
            <ul class="rows"></ul>
            <p class="total"><span>Total</span><strong></strong></p>
            <p class="note">Delivery cost is confirmed on WhatsApp.</p>
            <label>Your name <span class="optional">Optional</span><input name="name" autocomplete="name"></label>
            <label>Area in Abuja <span class="optional">Optional</span><input name="area" placeholder="Wuse 2, Gwarinpa, Lugbe" autocomplete="address-level2"></label>
            <a class="btn btn-fire send" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7.9 20A9 9 0 1 0 4 16.1L2.5 21.5Z"></path>
                    <path d="M9.2 8.4c-.5.3-.9.8-.8 1.5.3 2.7 2.5 4.9 5.2 5.4.8.1 1.4-.3 1.7-.9l-1.8-1.1-.9.7a4.2 4.2 0 0 1-2.2-2.2l.7-.9z"></path>
                </svg>
                Send order on WhatsApp
            </a>
            <p class="note">We confirm stock and send an invoice. You pay by bank transfer.</p>
        </div>
    </dialog>

    <template id="row">
        <li class="row">
            <img alt="" width="480" height="600">
            <div>
                <p class="row-title"></p>
                <p class="row-price"></p>
            </div>
            <div class="stepper">
                <button type="button" data-step="-1" data-id aria-label="Remove one">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                    </svg>
                </button>
                <output>0</output>
                <button type="button" data-step="1" data-id aria-label="Add one more">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                </button>
            </div>
        </li>
    </template>
    <p class="sr-only" aria-live="polite" id="announce"></p>

    <script is:inline define:vars={{ catalog }}>
        window.BIMA_CATALOG = catalog;
    </script>
    <script is:inline src="/config.js"></script>
    <script is:inline src="/cart.js"></script>
    <script is:inline src="/catalog.js"></script>
</body>
</html>

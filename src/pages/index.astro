---
import '../styles/global.css';
import { books } from '../data/books.js';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Find the perfect books for your little one with BIMA Books. A playful quiz for babies and young readers, with cosy picks you can order on WhatsApp.">
    <title>BIMA Books | Find the Perfect Books for Your Little One</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="BIMA Books home">
                <span class="brand-mark">BIMA</span>
                <span class="brand-sub">BOOKS</span>
            </a>
            <nav class="site-nav">
                <a href="/checkout" class="nav-order">Order <span class="nav-count" data-cart-count>0</span></a>
                <a href="https://www.instagram.com/bima_books/" target="_blank" rel="noopener">Instagram</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="hero" id="hero">
            <div class="container hero-inner">
                <div class="hero-visual">
                    <div class="hero-photo-frame">
                        <picture>
                            <source type="image/webp" srcset="/books/hero/bima-hero-640.webp 640w, /books/hero/bima-hero-1200.webp 1200w" sizes="(max-width: 920px) 78vw, 440px">
                            <img class="hero-photo" src="/books/hero/bima-hero-1200.jpg" alt="A little reader with BIMA Books" width="1200" height="1200" fetchpriority="high">
                        </picture>
                    </div>
                    <div class="bubble bubble-1">Bedtime</div>
                    <div class="bubble bubble-2">First words</div>
                    <div class="bubble bubble-3">Animals</div>
                </div>
                <div class="hero-content">
                    <span class="eyebrow">For babies & little explorers</span>
                    <h1>Find the perfect books to grow with your little one</h1>
                    <p>Take our playful quiz. We'll build a cosy stack tailored to their age, interests and reading style.</p>
                    <button class="btn btn-primary" id="startQuiz">Start the book finder</button>
                    <div class="hero-badges">
                        <div class="badge">Board books & lift-the-flaps</div>
                        <div class="badge">Sturdy little pages</div>
                        <div class="badge">Made for snuggles</div>
                    </div>
                </div>
            </div>
            <div class="hero-wave"></div>
        </section>

        <section class="quiz" id="quiz" aria-live="polite">
            <div class="container">
                <div class="quiz-topbar">
                    <button class="quiz-exit" id="exitQuiz" type="button">← Home</button>
                    <div class="quiz-header">
                        <div class="progress">
                            <div class="progress-bar" id="progressBar"></div>
                        </div>
                        <div class="progress-text"><span id="currentStep">1</span> of <span id="totalSteps">5</span></div>
                    </div>
                </div>
                <div class="quiz-card" id="quizCard"></div>
            </div>
        </section>

        <section class="results" id="results">
            <div class="container">
                <div class="results-header">
                    <span class="eyebrow">Your little one's stack</span>
                    <h2>Snuggle-ready picks just for you</h2>
                    <p>We chose these from the real BIMA shelf, based on your answers. Add any book to your order, then send it over on WhatsApp.</p>
                </div>
                <div class="stack-grid" id="stackGrid"></div>
                <div class="results-actions">
                    <button class="btn btn-ghost" id="restartQuiz">Take quiz again</button>
                    <button class="btn btn-soft" id="addAllPicks">Add all 3 to order</button>
                    <a class="btn btn-whatsapp" id="whatsappOrder" href="#" target="_blank" rel="noopener">Order via WhatsApp</a>
                </div>

                <div class="shelf-section">
                    <div class="shelf-header">
                        <div>
                            <span class="eyebrow">More from the shelf</span>
                            <h3>Keep browsing</h3>
                        </div>
                        <a class="text-link" href="/checkout">View my order →</a>
                    </div>
                    <div class="shelf-grid" id="shelfGrid"></div>
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="brand" href="/">
                <span class="brand-mark">BIMA</span>
                <span class="brand-sub">BOOKS</span>
            </a>
            <p>Made with snuggles for little readers.</p>
            <a href="https://www.instagram.com/bima_books/" target="_blank" rel="noopener">@bima_books</a>
        </div>
    </footer>

    <a class="cart-fab" href="/checkout" data-cart-fab aria-label="View your order">
        <span class="cart-fab-label">Your order</span>
        <span class="cart-fab-count" data-cart-count>0</span>
    </a>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <template id="stepTemplate">
        <div class="step">
            <div class="step-header">
                <h2 class="step-title"></h2>
                <p class="step-subtitle"></p>
            </div>
            <div class="options-grid"></div>
            <div class="step-actions">
                <button class="btn btn-ghost btn-back" type="button">Back</button>
                <button class="btn btn-primary btn-next" type="button" disabled>Next</button>
            </div>
        </div>
    </template>

    <template id="optionTemplate">
        <button class="option-card" type="button">
            <span class="option-emoji"></span>
            <span class="option-text">
                <span class="option-title"></span>
                <span class="option-desc"></span>
            </span>
            <span class="option-check">✓</span>
        </button>
    </template>

    <template id="bookCardTemplate">
        <article class="book-card">
            <div class="book-cover">
                <picture>
                    <source type="image/webp">
                    <img class="book-cover-img" loading="lazy" decoding="async" alt="">
                </picture>
                <span class="book-badge"></span>
            </div>
            <div class="book-info">
                <span class="book-tag"></span>
                <h3 class="book-title"></h3>
                <p class="book-author"></p>
                <p class="book-reason"></p>
                <div class="book-actions">
                    <button class="btn btn-primary add-to-order" type="button">Add to order</button>
                </div>
            </div>
        </article>
    </template>

    <template id="shelfCardTemplate">
        <article class="shelf-card">
            <div class="shelf-cover">
                <picture>
                    <source type="image/webp">
                    <img class="shelf-cover-img" loading="lazy" decoding="async" alt="">
                </picture>
            </div>
            <div class="shelf-info">
                <h3 class="shelf-title"></h3>
                <p class="shelf-author"></p>
                <button class="shelf-add" type="button">Add</button>
            </div>
        </article>
    </template>

    <script is:inline define:vars={{ books }}>
        window.BIMA_BOOKS = books;
    </script>
    <script is:inline src="/config.js"></script>
    <script is:inline src="/cart.js"></script>
    <script is:inline src="/app.js"></script>
</body>
</html>
